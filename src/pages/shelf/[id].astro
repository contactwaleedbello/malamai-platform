---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ErrorNotice from "../../components/ErrorNotice.astro";
import { getResources, getResourceById, getCurrentUser } from "../../lib/data.js";

export async function getStaticPaths() {
  const all = await getResources();
  return all.map((r) => ({
    params: { id: r.id }
  }));
}

const { id } = Astro.params;

let resource = null;
let user = null;
let fetchError = null;

try {
  resource = await getResourceById(id);
  user = await getCurrentUser();
} catch (e) {
  fetchError = e.message || "Failed to load resource.";
}

function getFileType(fileUrl) {
  if (!fileUrl) return "PDF";
  const lower = fileUrl.toLowerCase();
  if (lower.endsWith(".png") || lower.endsWith(".jpg") || lower.endsWith(".jpeg") || lower.endsWith(".webp")) {
    return "Image";
  }
  return "PDF";
}

function formatDate(isoStr) {
  try {
    const d = new Date(isoStr);
    return d.toLocaleDateString("en-NG", { day: "numeric", month: "short", year: "numeric" });
  } catch {
    return "Recent";
  }
}

function getSourceChoiceLabel(choice) {
  if (choice === "original" || choice === "I made this") return "I made this / Malam ya samar da wannan";
  if (choice === "openly_licensed" || choice === "Openly licensed") return "Openly licensed (reused with credit)";
  if (choice === "official" || choice === "Official document") return "Official educational curriculum document";
  return "Teacher contribution";
}

const fileType = resource ? getFileType(resource.file_url || resource.fileUrl) : "PDF";
const isPending = resource && resource.status === "pending";
---

<BaseLayout title={resource ? resource.title : "Resource Detail"} activeNav="resources">

  <!-- Back Link -->
  <div style="margin-bottom: var(--space-4);">
    <a href="/shelf" class="mc-back-btn">
      <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Back to resource shelf</span>
    </a>
  </div>

  {fetchError ? (
    <ErrorNotice message={fetchError} retryAction={true} />
  ) : resource && (
    <div class="mc-resource-view" id="resource-detail-view" data-resource-id={resource.id}>
      
      <!-- Moderator Pending Notice (PRD Rule F2-06) -->
      {isPending && (
        <div class="mc-pending-review-banner" role="status">
          <svg class="icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <div class="mc-pending-review-banner__text">
            <strong>Waiting for review / Ana jiran dubawa</strong>
            <span>Your upload will appear on the public shelf once checked by a moderator.</span>
          </div>
        </div>
      )}

      <!-- MAIN RESOURCE CARD -->
      <article class="mc-resource-detail-card">
        
        <!-- Header Tags -->
        <div class="mc-detail-badges">
          <span class="mc-tag mc-tag--subject">{resource.subject}</span>
          <span class="mc-tag mc-tag--class">{resource.class_level || resource.classLevel}</span>
          <span class="mc-tag mc-tag--lang">{resource.language}</span>
          <span class={`mc-file-type-pill ${fileType === 'PDF' ? 'mc-file-type-pill--pdf' : 'mc-file-type-pill--img'}`}>
            {fileType}
          </span>
          <span class="mc-file-size-badge">{resource.file_size || resource.fileSize || "84 KB"}</span>
        </div>

        <h1 class="mc-detail-title">
          {resource.title}
        </h1>

        <!-- Attribution & Metadata Table -->
        <div class="mc-meta-grid">
          <div class="mc-meta-item">
            <span class="mc-meta-label">Shared by</span>
            <span class="mc-meta-value">Malam {resource.uploader_first_name || (resource.author && resource.author.firstName)}</span>
          </div>

          <div class="mc-meta-item">
            <span class="mc-meta-label">Uploaded</span>
            <span class="mc-meta-value"><time datetime={resource.created_at}>{formatDate(resource.created_at)}</time></span>
          </div>

          <div class="mc-meta-item">
            <span class="mc-meta-label">Source</span>
            <span class="mc-meta-value">{getSourceChoiceLabel(resource.source_choice || resource.sourceChoice)}</span>
          </div>

          <div class="mc-meta-item">
            <span class="mc-meta-label">License (PRD F2-04)</span>
            <span class="mc-meta-value">
              <strong>{resource.license || "CC-BY-NC"}</strong> 
              <small style="color: var(--text-muted); display: block;">Credit required for classroom reuse</small>
            </span>
          </div>
        </div>

        <!-- Download & Usage Actions -->
        <div class="mc-action-bar">
          
          <!-- Download Button -->
          <a 
            href={resource.file_url || resource.fileUrl || "/files/worksheet_download.pdf"} 
            class="mc-btn mc-btn--primary mc-download-btn" 
            download
            id="btn-download"
          >
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download {fileType} ({resource.file_size || resource.fileSize || "84 KB"})</span>
          </a>

          <!-- 'I used this' Counter Button (PRD Rule F2-08) -->
          <button 
            type="button" 
            class="mc-btn mc-btn--secondary mc-used-action-btn" 
            id="btn-used-this"
            data-resource-id={resource.id}
          >
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span id="used-action-label">I used this in my class / Na yi amfani da wannan</span>
            <span class="mc-used-count-pill" id="used-count-display">
              {resource.used_count || resource.usedCount || 0}
            </span>
          </button>

          <!-- Offline Save Button -->
          <button 
            type="button" 
            class="mc-btn mc-btn--secondary mc-save-btn" 
            id="btn-save-shelf-item"
            data-resource-id={resource.id}
            data-title={resource.title}
          >
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <span id="save-shelf-text">Save to this phone</span>
          </button>

          <!-- Report Resource Button (PRD Section 7.1, 8.2 & 15.5) -->
          <button 
            type="button" 
            class="mc-btn mc-btn--secondary" 
            data-action="report"
            data-report-type="resource"
            data-report-id={resource.id}
            data-report-title={resource.title}
            title="Report this resource"
          >
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
              <line x1="4" y1="22" x2="4" y2="15"></line>
            </svg>
            <span>Report</span>
          </button>
        </div>

        <!-- Storage Error Alert (PRD Rule F3-03) -->
        <div id="save-shelf-error-alert" class="mc-feedback mc-feedback--warning" style="display: none; margin-top: var(--space-3);" role="alert">
          <svg class="icon mc-feedback__icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <div class="mc-feedback__body">
            <strong class="mc-feedback__title">Storage Note</strong>
            <p class="mc-feedback__message" id="save-shelf-error-text">This phone could not save the file. You can still open it online.</p>
          </div>
        </div>

        <!-- Hidden JSON for atomic offline caching -->
        <script type="application/json" id="shelf-offline-payload" set:html={JSON.stringify({
          id: resource.id,
          type: "resource",
          title: resource.title,
          subject: resource.subject,
          class_level: resource.class_level || resource.classLevel,
          language: resource.language,
          source_choice: resource.source_choice || resource.sourceChoice,
          license: resource.license,
          uploader_first_name: resource.uploader_first_name || (resource.author && resource.author.firstName),
          uploader_state: resource.author ? resource.author.state : "Kaduna",
          file_url: resource.file_url || resource.fileUrl,
          file_size: resource.file_size || resource.fileSize,
          created_at: resource.created_at,
          used_count: resource.used_count || resource.usedCount || 0
        })}></script>

      </article>

    </div>
  )}

</BaseLayout>

<script>
  import { recordResourceUsed } from "../../lib/data.js";
  import { saveItemToPhone, isItemSaved } from "../../lib/offlineStore.js";

  document.addEventListener('DOMContentLoaded', () => {
    const detailView = document.getElementById('resource-detail-view');
    if (!detailView) return;

    const resourceId = detailView.getAttribute('data-resource-id');
    const usedBtn = document.getElementById('btn-used-this');
    const usedLabel = document.getElementById('used-action-label');
    const countDisplay = document.getElementById('used-count-display');
    const saveBtn = document.getElementById('btn-save-shelf-item');
    const saveText = document.getElementById('save-shelf-text');

    // 1. Session Storage Guard for "I used this" (PRD Rule F2-08)
    const sessionUsedKey = `malamai_used_res_${resourceId}`;
    if (sessionStorage.getItem(sessionUsedKey)) {
      if (usedBtn) {
        usedBtn.classList.add('is-used');
        usedBtn.setAttribute('disabled', 'true');
      }
      if (usedLabel) usedLabel.textContent = "You recorded classroom use ✓";
    }

    usedBtn?.addEventListener('click', async () => {
      if (!resourceId) return;
      if (sessionStorage.getItem(sessionUsedKey)) return;

      try {
        const res = await recordResourceUsed(resourceId);
        sessionStorage.setItem(sessionUsedKey, 'true');
        if (countDisplay) countDisplay.textContent = String(res.resource.used_count);
        if (usedBtn) {
          usedBtn.classList.add('is-used');
          usedBtn.setAttribute('disabled', 'true');
        }
        if (usedLabel) usedLabel.textContent = "You recorded classroom use ✓";
      } catch (err) {
        console.error("Usage record failed", err);
      }
    });

    // 2. Offline Save to Phone
    if (isItemSaved(resourceId)) {
      if (saveBtn) {
        saveBtn.classList.add('is-saved');
        saveBtn.setAttribute('disabled', 'true');
      }
      if (saveText) saveText.textContent = "Saved to phone ✓";
    }

    saveBtn?.addEventListener('click', () => {
      const payloadEl = document.getElementById('shelf-offline-payload');
      const errBanner = document.getElementById('save-shelf-error-alert');
      const errText = document.getElementById('save-shelf-error-text');

      if (!payloadEl) return;
      try {
        const payloadData = JSON.parse(payloadEl.textContent || '{}');
        const saveRes = saveItemToPhone(payloadData);

        if (saveRes.success) {
          if (errBanner) errBanner.style.display = 'none';
          saveBtn.classList.add('is-saved');
          saveBtn.setAttribute('disabled', 'true');
          if (saveText) saveText.textContent = "Saved to phone ✓";
        } else {
          if (errBanner && errText) {
            errText.textContent = saveRes.error || "This phone could not save the file. You can still open it online.";
            errBanner.style.display = 'flex';
          }
        }
      } catch (e: any) {
        if (errBanner && errText) {
          errText.textContent = "This phone could not save the file. You can still open it online.";
          errBanner.style.display = 'flex';
        }
      }
    });
  });
</script>

<style>
  .mc-back-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--brand-primary);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
  }

  .mc-back-btn:hover {
    color: var(--brand-primary-hover);
    text-decoration: underline;
  }

  .mc-resource-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mc-pending-review-banner {
    background: var(--warning-tint);
    border: 1px solid var(--warning-border);
    border-left: 4px solid var(--warning);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mc-pending-review-banner svg {
    color: var(--warning);
    flex-shrink: 0;
  }

  .mc-pending-review-banner__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    font-size: var(--fs-small);
    color: var(--navy-950);
  }

  /* Resource Detail Card */
  .mc-resource-detail-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5);
    box-shadow: var(--shadow-card);
  }

  .mc-detail-badges {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .mc-tag {
    font-size: var(--fs-micro);
    font-weight: var(--fw-semibold);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .mc-tag--subject {
    background: var(--brand-primary-tint);
    color: var(--brand-primary);
    border: 1px solid var(--border-subtle);
  }

  .mc-tag--class {
    background: var(--surface-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .mc-tag--lang {
    background: var(--surface-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .mc-file-type-pill {
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .mc-file-type-pill--pdf {
    background: var(--danger-tint);
    color: var(--danger);
    border: 1px solid var(--danger-border);
  }

  .mc-file-type-pill--img {
    background: var(--info-tint);
    color: var(--info);
    border: 1px solid var(--info-border);
  }

  .mc-file-size-badge {
    font-size: var(--fs-micro);
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--surface-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .mc-detail-title {
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    color: var(--brand-navy);
    margin: 0 0 var(--space-5) 0;
    line-height: var(--lh-h2);
  }

  /* Metadata Grid */
  .mc-meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-5);
  }

  @media (min-width: 600px) {
    .mc-meta-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mc-meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mc-meta-label {
    font-size: var(--fs-micro);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mc-meta-value {
    font-size: var(--fs-body);
    color: var(--text-primary);
  }

  /* Action Bar */
  .mc-action-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .mc-download-btn {
    min-height: var(--touch-min);
  }

  .mc-used-action-btn {
    min-height: var(--touch-min);
  }

  .mc-used-action-btn.is-used {
    background: var(--success-tint);
    color: var(--success);
    border-color: var(--success-border);
  }

  .mc-used-count-pill {
    background: var(--brand-primary);
    color: #fff;
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    margin-left: 4px;
  }

  .mc-used-action-btn.is-used .mc-used-count-pill {
    background: var(--success);
  }

  .mc-save-btn.is-saved {
    background: var(--success-tint);
    color: var(--success);
    border-color: var(--success-border);
  }
</style>
