---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import ErrorNotice from "../../components/ErrorNotice.astro";
import Skeleton from "../../components/Skeleton.astro";
import { getQuestions, getCurrentUser } from "../../lib/data.js";

const url = new URL(Astro.request.url);
const subjectFilter = url.searchParams.get("subject") || "";
const classFilter = url.searchParams.get("class") || "";
const languageFilter = url.searchParams.get("lang") || "";
const stillNeedsAnswer = url.searchParams.get("unanswered") === "true";

let questions = [];
let user = null;
let fetchError = null;

try {
  user = await getCurrentUser();
  questions = await getQuestions({
    subject: subjectFilter,
    class_level: classFilter,
    language: languageFilter,
    unanswered: stillNeedsAnswer
  });
} catch (e) {
  fetchError = e.message || "Failed to load questions from database.";
}

// Science subjects check for PRD Section 8.3 / Rule F1-06
const scienceSubjects = ["basic science", "chemistry", "biology", "physics", "science"];
const isScienceSelected = subjectFilter && scienceSubjects.some(s => subjectFilter.toLowerCase().includes(s));

// Subjects list
const subjects = [
  "Mathematics",
  "Basic Science",
  "English Language",
  "Hausa",
  "Social Studies",
  "Agricultural Science",
  "Basic Technology",
  "Chemistry",
  "Biology",
  "Physics"
];

// Class levels list
const classLevels = [
  "Primary 1", "Primary 2", "Primary 3", "Primary 4", "Primary 5", "Primary 6",
  "JSS 1", "JSS 2", "JSS 3",
  "SS 1", "SS 2", "SS 3"
];

function formatDate(isoStr) {
  try {
    const d = new Date(isoStr);
    const now = new Date();
    const diffDays = Math.floor((now - d) / (1000 * 60 * 60 * 24));
    if (diffDays === 0) return "Today";
    if (diffDays === 1) return "Yesterday";
    if (diffDays < 7) return `${diffDays} days ago`;
    if (diffDays < 14) return "1 week ago";
    return d.toLocaleDateString("en-NG", { day: "numeric", month: "short", year: "numeric" });
  } catch {
    return "Recent";
  }
}

function isUnanswered(q) {
  if (q.helped_reply_id) return false;
  if ((q.reply_count || 0) === 0) return true;
  try {
    const daysOld = Math.floor((new Date() - new Date(q.created_at)) / (1000 * 60 * 60 * 24));
    return daysOld >= 7;
  } catch {
    return false;
  }
}
---

<BaseLayout title="Subject & Class Boards" activeNav="questions">

  <!-- Header & Actions -->
  <div class="mc-board-header">
    <div>
      <h1 class="mc-board-header__title">Classroom Question Boards</h1>
      <p class="mc-board-header__subtitle">
        Teacher-to-teacher questions and practical solutions across Northern Nigeria.
      </p>
    </div>
    <div class="mc-board-header__actions">
      <a href="/ask" class="mc-btn mc-btn--primary" id="btn-ask-top">
        <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Ask a question / Yi tambaya</span>
      </a>
    </div>
  </div>

  <!-- FIXED SCIENCE SAFETY NOTICE (PRD Section 8.3 & Rule F1-06) -->
  <div class="mc-safety-notice" role="alert" id="science-safety-notice" style={isScienceSelected ? "display: flex;" : "display: none;"}>
    <svg class="icon mc-safety-notice__icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
      <line x1="12" y1="9" x2="12" y2="13"></line>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
    <div>
      <strong>Science Safety Note:</strong>
      <span> Safety first. Check any practical activity for your class before you run it. This is teacher advice, not a safety authority.</span>
    </div>
  </div>

  {fetchError && (
    <ErrorNotice message={fetchError} retryAction={true} />
  )}

  <!-- FILTER CONTROLS (PRD Rule F1-03: Filters only, no search box) -->
  <section class="mc-filter-panel" aria-label="Question board filters">
    
    <!-- Horizontal Scrolling Filter Chips for One-Handed Mobile Use -->
    <nav class="mc-chip-bar" aria-label="Subject and urgency filter chips">
      <a href="/boards" class:list={["mc-chip", { "is-active": !subjectFilter && !stillNeedsAnswer }]}>
        All Subjects
      </a>
      <a href="/boards?unanswered=true" class:list={["mc-chip", { "is-active": stillNeedsAnswer }]}>
        <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Needs Answer
      </a>
      {subjects.slice(0, 6).map((sub) => (
        <a 
          href={`/boards?subject=${encodeURIComponent(sub)}${classFilter ? `&class=${encodeURIComponent(classFilter)}` : ""}${languageFilter ? `&lang=${encodeURIComponent(languageFilter)}` : ""}`} 
          class:list={["mc-chip", { "is-active": subjectFilter.toLowerCase() === sub.toLowerCase() }]}
        >
          {sub}
        </a>
      ))}
    </nav>

    <form method="get" action="/boards" id="filter-form" class="mc-filter-grid">
      
      <!-- Subject Filter -->
      <div class="mc-filter-field">
        <label for="filter-subject" class="mc-filter-label">Subject</label>
        <div class="mc-select-wrapper">
          <select id="filter-subject" name="subject" class="mc-select" onchange="this.form.submit()">
            <option value="">All Subjects</option>
            {subjects.map((sub) => (
              <option value={sub} selected={subjectFilter.toLowerCase() === sub.toLowerCase()}>{sub}</option>
            ))}
          </select>
          <svg class="icon mc-select-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
      </div>

      <!-- Class Level Filter -->
      <div class="mc-filter-field">
        <label for="filter-class" class="mc-filter-label">Class Level</label>
        <div class="mc-select-wrapper">
          <select id="filter-class" name="class" class="mc-select" onchange="this.form.submit()">
            <option value="">All Classes</option>
            {classLevels.map((lvl) => (
              <option value={lvl} selected={classFilter === lvl}>{lvl}</option>
            ))}
          </select>
          <svg class="icon mc-select-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
      </div>

      <!-- Language Filter -->
      <div class="mc-filter-field">
        <label for="filter-lang" class="mc-filter-label">Language</label>
        <div class="mc-select-wrapper">
          <select id="filter-lang" name="lang" class="mc-select" onchange="this.form.submit()">
            <option value="">All Languages</option>
            <option value="English" selected={languageFilter.toLowerCase() === "english"}>English</option>
            <option value="Hausa" selected={languageFilter.toLowerCase() === "hausa"}>Hausa</option>
          </select>
          <svg class="icon mc-select-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
      </div>

      <!-- Still Needs An Answer Toggle & Reset -->
      <div class="mc-filter-actions">
        <label class="mc-checkbox-label">
          <input 
            type="checkbox" 
            id="filter-unanswered" 
            name="unanswered" 
            value="true" 
            checked={stillNeedsAnswer} 
            onchange="this.form.submit()" 
            class="mc-checkbox" 
          />
          <span>Still needs an answer / Yana buƙatar amsa</span>
        </label>

        {(subjectFilter || classFilter || languageFilter || stillNeedsAnswer) && (
          <a href="/boards" class="mc-filter-reset-link">
            Clear filters
          </a>
        )}
      </div>

    </form>
  </section>

  <!-- QUESTION THREAD LIST -->
  <section class="mc-threads-container" aria-label="Questions list" id="threads-list">
    {questions.length === 0 ? (
      <div class="mc-empty-box">
        <svg class="icon mc-empty-icon" viewBox="0 0 24 24" width="48" height="48" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <h2 class="mc-empty-title">No questions here yet. Be the first to ask.</h2>
        <p class="mc-empty-subtitle">
          Babu tambayoyi a wannan fannin tukuna. Zama na farko da zai yi tambaya.
        </p>
        <a href="/ask" class="mc-btn mc-btn--primary mc-empty-cta">
          <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Ask a question</span>
        </a>
      </div>
    ) : (
      <div class="mc-card-stack">
        {questions.map((q) => {
          const needsAnswer = isUnanswered(q);
          const hasHelped = Boolean(q.helped_reply_id);

          return (
            <article 
              class={`mc-thread-card ${needsAnswer ? "mc-thread-card--unanswered" : ""}`} 
              id={`thread-${q.id}`}
              data-subject={q.subject}
              data-class={q.class_level || q.classLevel}
              data-lang={q.language}
              data-unanswered={needsAnswer ? "true" : "false"}
            >
              
              <div class="mc-thread-meta">
                <div class="mc-thread-badges">
                  <span class="mc-tag mc-tag--subject">{q.subject}</span>
                  <span class="mc-tag mc-tag--class">{q.class_level || q.classLevel}</span>
                  <span class="mc-tag mc-tag--lang">{q.language}</span>
                </div>

                {needsAnswer && (
                  <span class="mc-status-badge mc-status-badge--pending" title="Question still needs an answer">
                    <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Still needs an answer</span>
                  </span>
                )}

                {hasHelped && (
                  <span class="mc-status-badge mc-status-badge--success" title="The teacher marked an answer as helpful">
                    <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Solved / An taimaka</span>
                  </span>
                )}
              </div>

              <h2 class="mc-thread-title">
                <a href={`/questions/${q.id}`} class="mc-thread-link">
                  {q.title}
                </a>
              </h2>

              <p class="mc-thread-snippet">
                {q.body.length > 150 ? q.body.substring(0, 150) + "..." : q.body}
              </p>

              <!-- Footer: First name, State, Relative date, Reply count. NO surname, phone, or school. -->
              <div class="mc-thread-footer">
                <div class="mc-author-info">
                  <span>Malam {q.author_first_name || (q.author && q.author.firstName)}</span>
                  <span class="mc-dot">•</span>
                  <span>{q.author_state || (q.author && q.author.state)} State</span>
                  <span class="mc-dot">•</span>
                  <time datetime={q.created_at}>{formatDate(q.created_at)}</time>
                </div>

                <div class="mc-thread-replies">
                  <a href={`/questions/${q.id}`} class="mc-reply-pill">
                    <svg class="icon" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>{q.reply_count || (q.replies ? q.replies.length : 0)} {(q.reply_count === 1 || (q.replies && q.replies.length === 1)) ? "reply" : "replies"}</span>
                  </a>
                </div>
              </div>

            </article>
          );
        })}
      </div>
    )}
  </section>

</BaseLayout>

<style>
  .mc-board-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .mc-board-header__title {
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-1) 0;
    line-height: var(--lh-h2);
    letter-spacing: -0.01em;
  }

  .mc-board-header__subtitle {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 0;
  }

  .mc-board-header__actions {
    display: flex;
    align-items: center;
  }

  /* Fixed Science Safety Notice (Rule F1-06 & Section 8.3) */
  .mc-safety-notice {
    background: var(--warning-tint);
    border: 1px solid var(--warning-border);
    border-left: 5px solid var(--warning);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--text-primary);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    box-shadow: var(--shadow-subtle);
  }

  .mc-safety-notice__icon {
    color: var(--warning);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Filter Controls */
  .mc-filter-panel {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
    box-shadow: var(--shadow-subtle);
  }

  .mc-filter-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    align-items: flex-end;
  }

  @media (min-width: 640px) {
    .mc-filter-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .mc-filter-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mc-filter-label {
    font-size: var(--fs-micro);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mc-filter-actions {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
  }

  .mc-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    cursor: pointer;
  }

  .mc-checkbox {
    width: 18px;
    height: 18px;
    accent-color: var(--brand-primary);
    cursor: pointer;
  }

  .mc-filter-reset-link {
    font-size: var(--fs-micro);
    color: var(--brand-primary);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }

  .mc-filter-reset-link:hover {
    text-decoration: underline;
  }

  /* Thread Cards List */
  .mc-card-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mc-thread-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    box-shadow: var(--shadow-card);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .mc-thread-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-elevated);
  }

  .mc-thread-card--unanswered {
    border-left: 4px solid var(--status-pending);
  }

  .mc-thread-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .mc-thread-badges {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .mc-tag {
    font-size: var(--fs-micro);
    font-weight: var(--fw-semibold);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .mc-tag--subject {
    background: var(--brand-primary-tint);
    color: var(--brand-primary);
    border: 1px solid var(--border-subtle);
  }

  .mc-tag--class {
    background: var(--surface-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .mc-tag--lang {
    background: var(--surface-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .mc-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-micro);
    font-weight: var(--fw-semibold);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .mc-status-pill--warning {
    background: var(--warning-tint);
    color: var(--warning);
    border: 1px solid var(--warning-border);
  }

  .mc-status-pill--success {
    background: var(--success-tint);
    color: var(--success);
    border: 1px solid var(--success-border);
  }

  .mc-thread-title {
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-bold);
    margin: 0 0 var(--space-2) 0;
    line-height: var(--lh-title-sm);
  }

  .mc-thread-link {
    color: var(--brand-navy, var(--text-primary));
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .mc-thread-link:hover {
    color: var(--brand-primary);
  }

  .mc-thread-snippet {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    margin: 0 0 var(--space-3) 0;
    line-height: var(--lh-body);
  }

  .mc-thread-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--fs-micro);
    color: var(--text-muted);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
  }

  .mc-author-info {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .mc-dot {
    color: var(--border-strong);
  }

  .mc-reply-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--brand-primary);
    background: var(--brand-primary-tint);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: var(--fw-semibold);
  }

  .mc-reply-pill:hover {
    background: var(--teal-100);
  }

  /* Empty Box */
  .mc-empty-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8) var(--space-4);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
  }

  .mc-empty-icon {
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .mc-empty-title {
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-bold);
    color: var(--brand-navy);
    margin: 0 0 var(--space-1) 0;
  }

  .mc-empty-subtitle {
    font-size: var(--fs-small);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4) 0;
  }

  .mc-empty-cta {
    min-height: var(--touch-min);
  }
</style>
