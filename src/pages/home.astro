---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import ErrorNotice from "../components/ErrorNotice.astro";
import { getCurrentUser, getHomeQuestions, getHomeActivity } from "../lib/data.js";

// Fetch profile-driven lists from the Seam Pattern (PRD Section 6)
let user = null;
let homeQuestions = [];
let homeActivity = [];
let fetchError = null;

try {
  user = await getCurrentUser();
  homeQuestions = await getHomeQuestions(user);
  homeActivity = await getHomeActivity(user);
} catch (e) {
  fetchError = e.message || "Unable to connect to school server.";
}

const subjectsList = user?.subjects || ["Mathematics"];
const classesList = user?.class_levels || user?.classLevels || ["JSS 1", "JSS 2"];
---

<BaseLayout title="Home Dashboard" activeNav="home">
  
  {fetchError && (
    <ErrorNotice message={fetchError} retryAction={true} />
  )}

  <div class="mc-home-container">
    <!-- Teacher Greeting & Status Card -->
    {user && (
      <section class="mc-teacher-card" aria-label="Current Educator Profile">
        <div class="mc-teacher-card__main">
          <div class="mc-teacher-avatar" aria-hidden="true">
            {(user.first_name || user.firstName || "M")[0]}
          </div>
          <div class="mc-teacher-card__info">
            <div class="mc-teacher-card__title-row">
              <h1 class="mc-teacher-card__name">Sannu, Malam {user.first_name || user.firstName}</h1>
              {user.trcn_registered || user.trcnRegistered ? (
                <span class="mc-pill mc-pill--verified" title="Verified on TRCN national register">
                  <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                  <span>TRCN registered</span>
                </span>
              ) : (
                <span class="mc-pill mc-pill--neutral">
                  <span>Educator Member</span>
                </span>
              )}
            </div>
            <p class="mc-teacher-card__meta">
              <span class="mc-meta-item">
                <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                {user.state} State ({user.lga} LGA)
              </span>
              <span class="mc-meta-bullet">•</span>
              <span class="mc-meta-item">{subjectsList.join(", ")}</span>
              <span class="mc-meta-bullet">•</span>
              <span class="mc-meta-item">{classesList.join(", ")}</span>
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Quick Action Launchpad -->
    <div class="mc-home-actions" role="region" aria-label="Teacher Quick Actions">
      <a href="/ask" class="mc-action-card mc-action-card--ask">
        <div class="mc-action-icon mc-action-icon--ask">
          <svg class="icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </div>
        <div class="mc-action-content">
          <span class="mc-action-title">Ask a question</span>
          <span class="mc-action-sub">Yi tambaya game da darasi</span>
        </div>
        <svg class="icon mc-action-arrow" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>

      <a href="/shelf/upload" class="mc-action-card mc-action-card--shelf">
        <div class="mc-action-icon mc-action-icon--shelf">
          <svg class="icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>
        <div class="mc-action-content">
          <span class="mc-action-title">Add a resource</span>
          <span class="mc-action-sub">Raba kayan aiki ko lesson plan</span>
        </div>
        <svg class="icon mc-action-arrow" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

    <!-- LIST ONE: Questions in my subject that still need an answer (PRD Section 6) -->
    <section class="mc-section" aria-labelledby="heading-list-one">
      <div class="mc-section__header">
        <div>
          <h2 id="heading-list-one" class="mc-section__title">
            Questions in my subject that still need an answer
          </h2>
          <p class="mc-section__sub">Colleagues waiting for your classroom experience</p>
        </div>
        <a href="/boards?filter=unanswered" class="mc-section__link">
          <span>See more</span>
          <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>

      {homeQuestions.length === 0 ? (
        <EmptyState 
          icon="clock"
          message="No open questions in your subjects right now. You can browse other subjects."
          actionText="Browse questions"
          actionHref="/boards"
        />
      ) : (
        <div class="mc-card-stack" id="home-questions-list">
          {homeQuestions.map((q) => (
            <article class="mc-q-card" id={`home-q-${q.id}`}>
              <div class="mc-q-card__header">
                <div class="mc-q-card__badges">
                  <span class="mc-pill mc-pill--warning">
                    <svg class="icon" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Needs answer</span>
                  </span>
                  <span class="mc-q-meta-tag">{q.subject}</span>
                  <span class="mc-meta-bullet">•</span>
                  <span class="mc-q-meta-tag">{q.class_level || q.classLevel}</span>
                </div>
              </div>

              <h3 class="mc-q-card__title">
                <a href={`/questions/${q.id}`}>
                  {q.title}
                </a>
              </h3>

              <p class="mc-q-card__body">
                {q.body.length > 140 ? q.body.substring(0, 140) + "..." : q.body}
              </p>

              <div class="mc-q-card__footer">
                <div class="mc-author-info">
                  <span class="mc-author-avatar">{(q.author_first_name || (q.author && q.author.firstName) || "M")[0]}</span>
                  <span>Malam {q.author_first_name || (q.author && q.author.firstName)} <span class="mc-author-state">({q.author_state || (q.author && q.author.state)} State)</span></span>
                </div>
                <a href={`/questions/${q.id}`} class="mc-btn mc-btn--secondary mc-btn-sm">
                  <span>Answer question</span>
                  <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <!-- LIST TWO: New for [the member's class and subject] (PRD Section 6) -->
    <section class="mc-section" aria-labelledby="heading-list-two">
      <div class="mc-section__header">
        <div>
          <h2 id="heading-list-two" class="mc-section__title">
            New for {subjectsList.join(" & ")} ({classesList.join(", ")})
          </h2>
          <p class="mc-section__sub">Fresh worksheets and discussion updates for your classes</p>
        </div>
        <a href="/shelf" class="mc-section__link">
          <span>See more</span>
          <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>

      {homeActivity.length === 0 ? (
        <EmptyState 
          icon="info-circle"
          message="Nothing new for your classes yet. Check the shelf or ask a question."
          actionText="Check shelf"
          actionHref="/shelf"
        />
      ) : (
        <div class="mc-card-stack" id="home-activity-list">
          {homeActivity.map((item) => (
            <article class="mc-activity-card" id={`home-act-${item.id}`}>
              <div class="mc-act-header">
                <div class="mc-act-badges">
                  {item.type === "resource" ? (
                    <span class="mc-pill mc-pill--verified">Worksheet</span>
                  ) : (
                    <span class="mc-pill mc-pill--accent">New Reply</span>
                  )}
                  <span class="mc-act-meta">
                    {item.subject} • {item.classLevel || item.class_level}
                  </span>
                </div>
              </div>

              <h3 class="mc-act-title">
                <a href={item.type === "resource" ? `/shelf/${item.id}` : `/questions/${item.questionId}`}>
                  {item.title}
                </a>
              </h3>

              <div class="mc-act-footer">
                <div class="mc-author-info">
                  <span class="mc-author-avatar">{(item.author && item.author.firstName ? item.author.firstName[0] : "M")}</span>
                  <span>By Malam {item.author && item.author.firstName}</span>
                </div>
                <a href={item.type === "resource" ? `/shelf/${item.id}` : `/questions/${item.questionId}`} class="mc-btn mc-btn--secondary mc-btn-sm">
                  <span>{item.type === "resource" ? "Open worksheet" : "View thread"}</span>
                  <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <!-- Community Notice & Scientific Disclaimer (PRD Rule F1-05 & HOME-01) -->
    <footer class="mc-home-footer">
      <div class="mc-footer-note">
        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>Teachers' advice, not official guidance. Malamai Circle is free and open source.</span>
      </div>
    </footer>
  </div>

</BaseLayout>

<style>
  .mc-home-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Teacher Greeting Card */
  .mc-teacher-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
  }

  .mc-teacher-card__main {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .mc-teacher-avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--brand-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    flex-shrink: 0;
  }

  .mc-teacher-card__info {
    flex: 1;
    min-width: 0;
  }

  .mc-teacher-card__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
  }

  .mc-teacher-card__name {
    font-size: var(--fs-title-lg);
    line-height: var(--lh-tight);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    margin: 0;
  }

  .mc-teacher-card__meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .mc-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .mc-meta-bullet {
    color: var(--text-subtle);
  }

  /* Quick Actions Launchpad */
  .mc-home-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .mc-action-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .mc-action-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-focus);
  }

  .mc-action-card--ask {
    border-left: 4px solid var(--brand-primary);
  }

  .mc-action-card--shelf {
    border-left: 4px solid var(--accent-teal);
  }

  .mc-action-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mc-action-icon--ask {
    background: var(--surface-bg);
    color: var(--brand-primary);
  }

  .mc-action-icon--shelf {
    background: var(--accent-subtle);
    color: var(--accent-teal);
  }

  .mc-action-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mc-action-title {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
  }

  .mc-action-sub {
    font-size: var(--fs-micro);
    color: var(--text-muted);
  }

  .mc-action-arrow {
    color: var(--text-muted);
    transition: transform 0.15s ease;
  }

  .mc-action-card:hover .mc-action-arrow {
    transform: translateX(3px);
    color: var(--brand-primary);
  }

  /* Section Styles */
  .mc-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mc-section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .mc-section__title {
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    margin: 0;
    line-height: var(--lh-tight);
  }

  .mc-section__sub {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 2px 0 0 0;
  }

  .mc-section__link {
    font-size: var(--fs-small);
    color: var(--brand-primary);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    transition: color 0.15s ease;
  }

  .mc-section__link:hover {
    color: var(--brand-hover);
    text-decoration: underline;
  }

  /* Question & Activity Card Stacks */
  .mc-card-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mc-q-card,
  .mc-activity-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .mc-q-card:hover,
  .mc-activity-card:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-focus);
  }

  .mc-q-card__header,
  .mc-act-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mc-q-card__badges,
  .mc-act-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .mc-q-meta-tag,
  .mc-act-meta {
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
  }

  .mc-q-card__title,
  .mc-act-title {
    font-size: var(--fs-body-lg);
    font-weight: var(--fw-bold);
    margin: 0;
    line-height: var(--lh-snug);
  }

  .mc-q-card__title a,
  .mc-act-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .mc-q-card__title a:hover,
  .mc-act-title a:hover {
    color: var(--brand-primary);
    text-decoration: underline;
  }

  .mc-q-card__body {
    font-size: var(--fs-small);
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin: 0;
  }

  .mc-q-card__footer,
  .mc-act-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .mc-author-info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .mc-author-avatar {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--surface-bg);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    border: 1px solid var(--border);
  }

  .mc-author-state {
    color: var(--text-subtle);
  }

  .mc-btn-sm {
    min-height: 36px;
    padding: var(--space-1) var(--space-3);
    font-size: var(--fs-small);
  }

  /* Home Footer */
  .mc-home-footer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .mc-footer-note {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
