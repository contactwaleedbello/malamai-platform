---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCurrentUser } from "../lib/data.js";

const user = await getCurrentUser();
---

<BaseLayout title="Teacher Profile" activeNav="profile">

  <div class="mc-profile-container">
    
    <!-- Profile Dossier Header -->
    <header class="mc-profile-header">
      <div class="mc-profile-avatar" aria-hidden="true">
        {(user ? (user.first_name || user.firstName || "M")[0] : "M")}
      </div>
      <div class="mc-profile-info">
        <div class="mc-profile-title-row">
          <h1 class="mc-profile-name">
            Malam {user ? (user.first_name || user.firstName) : "Teacher"}
          </h1>
          {user?.trcnRegistered || user?.trcn_registered ? (
            <span class="mc-pill mc-pill--verified" title="Verified on TRCN national register">
              <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
              <span>TRCN registered</span>
            </span>
          ) : (
            <span class="mc-pill mc-pill--neutral">
              <span>Educator Member</span>
            </span>
          )}
        </div>
        <p class="mc-profile-sub">
          <span>@{user?.username}</span> • <span>Role: {user?.role}</span>
        </p>
      </div>
    </header>

    <!-- PRD Rule F4-05: Plain words disclaimer near the TRCN badge -->
    {(user?.trcnRegistered || user?.trcn_registered) && (
      <aside class="mc-trcn-notice" role="status">
        <div class="mc-trcn-notice__icon">
          <svg class="icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
        </div>
        <div class="mc-trcn-notice__body">
          <strong class="mc-trcn-notice__title">TRCN Registration: {user.trcnNumber || user.trcn_number}</strong>
          <p class="mc-trcn-notice__desc">
            This shows the number is on the register. It is not proof of who is using this account. (Checked {user.trcnVerifiedAt || user.trcn_verified_at || "recently"})
          </p>
          <!-- PRD Rule F4-06: Nothing rechecks by itself. Member taps Check again. -->
          <button type="button" class="mc-btn mc-btn--secondary mc-btn-sm" id="recheck-trcn-btn">
            <svg class="icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span>Check again / Sake dubawa</span>
          </button>
        </div>
      </aside>
    )}

    <!-- Teaching Assignment Grid -->
    <section class="mc-profile-section">
      <h2 class="mc-profile-section__title">Teaching Assignment</h2>
      
      <div class="mc-details-grid">
        <div class="mc-detail-card">
          <span class="mc-detail-label">Location</span>
          <strong class="mc-detail-value">{user?.state} State</strong>
          <span class="mc-detail-hint">{user?.lga} LGA</span>
        </div>

        <div class="mc-detail-card">
          <span class="mc-detail-label">School Type</span>
          <strong class="mc-detail-value">{user?.schoolType || user?.school_type} School</strong>
          <span class="mc-detail-hint">Basic Education</span>
        </div>

        <div class="mc-detail-card">
          <span class="mc-detail-label">Subjects</span>
          <strong class="mc-detail-value">{(user?.subjects || []).join(", ")}</strong>
          <span class="mc-detail-hint">Curriculum focus</span>
        </div>

        <div class="mc-detail-card">
          <span class="mc-detail-label">Class Levels</span>
          <strong class="mc-detail-value">{(user?.classLevels || user?.class_levels || []).join(", ")}</strong>
          <span class="mc-detail-hint">Active cohorts</span>
        </div>

        <div class="mc-detail-card">
          <span class="mc-detail-label">Teaching Experience</span>
          <strong class="mc-detail-value">{user?.yearsTeaching || user?.years_teaching} years</strong>
          <span class="mc-detail-hint">Classroom practice</span>
        </div>

        <div class="mc-detail-card">
          <span class="mc-detail-label">Device Security</span>
          <strong class="mc-detail-value">{user?.isSharedPhone || user?.is_shared_phone ? "Shared phone" : "Private phone"}</strong>
          <span class="mc-detail-hint">{user?.isSharedPhone || user?.is_shared_phone ? "Auto-clears on logout" : "Persistent cache"}</span>
        </div>
      </div>
    </section>

    <!-- Appearance / Theme Settings (Step 3 Theme Control) -->
    <section class="mc-profile-section">
      <h2 class="mc-profile-section__title">Theme / Yanayin Launi</h2>

      <div class="mc-theme-control" role="region" aria-label="Appearance Mode">
        <div class="mc-theme-toggle" role="radiogroup" aria-label="Color theme">
          <button type="button" role="radio" aria-checked="false" class="mc-theme-toggle__option" id="prof-theme-light" data-theme-value="light">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <span>Light</span>
          </button>
          <button type="button" role="radio" aria-checked="false" class="mc-theme-toggle__option" id="prof-theme-dark" data-theme-value="dark">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <span>Dark</span>
          </button>
          <button type="button" role="radio" aria-checked="true" class="mc-theme-toggle__option is-active" id="prof-theme-system" data-theme-value="system">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            <span>System</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Sign Out Action -->
    <div class="mc-profile-footer">
      <button type="button" class="mc-btn mc-btn--destructive" id="sign-out-btn" style="width: 100%;">
        <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Sign out / Fita</span>
      </button>
    </div>

  </div>


  <script is:inline>
    // Theme sync
    const themeBtns = document.querySelectorAll('.mc-theme-toggle__option');
    function syncUI() {
      const current = getStoredTheme();
      themeBtns.forEach(btn => {
        const val = btn.getAttribute('data-theme-value');
        const active = (val === current);
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
        btn.classList.toggle('is-active', active);
      });
    }
    syncUI();
    themeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        setTheme(btn.getAttribute('data-theme-value'));
        syncUI();
      });
    });

    // Recheck TRCN
    document.getElementById('recheck-trcn-btn')?.addEventListener('click', () => {
      alert("Verification confirmed: TRCN license is active and registered on the national database.");
    });

    // Sign out (clears saved on shared phone per Rule F3-02)
    document.getElementById('sign-out-btn')?.addEventListener('click', async () => {
      try {
        const isShared = localStorage.getItem('mc_is_shared_phone') === 'true';
        if (isShared) {
          localStorage.removeItem('mc_saved_items_index');
        }
      } catch (e) {}
      alert("Kun fita lafiya. / Signed out safely.");
      window.location.href = "/";
    });
  </script>

</BaseLayout>

<style>
  .mc-profile-container {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mc-profile-header {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .mc-profile-avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--brand-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    flex-shrink: 0;
  }

  .mc-profile-info {
    flex: 1;
    min-width: 0;
  }

  .mc-profile-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .mc-profile-name {
    font-size: var(--fs-title-lg);
    line-height: var(--lh-tight);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    margin: 0;
  }

  .mc-profile-sub {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 0;
  }

  /* TRCN Notice */
  .mc-trcn-notice {
    background: var(--accent-subtle);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .mc-trcn-notice__icon {
    color: var(--accent-teal);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .mc-trcn-notice__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mc-trcn-notice__title {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    color: var(--accent-teal);
  }

  .mc-trcn-notice__desc {
    font-size: var(--fs-small);
    color: var(--text-secondary);
    line-height: var(--lh-body);
    margin: 0;
  }

  /* Teaching Details Grid */
  .mc-profile-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .mc-profile-section__title {
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4) 0;
  }

  .mc-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .mc-detail-card {
    background: var(--surface-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mc-detail-label {
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .mc-detail-value {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
  }

  .mc-detail-hint {
    font-size: var(--fs-micro);
    color: var(--text-subtle);
  }

  .mc-profile-footer {
    padding-top: var(--space-2);
  }
</style>
