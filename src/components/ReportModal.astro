---
// Global Member Reporting Modal (PRD Section 7.1, 8.2 & 15.5)
---

<dialog id="mc-report-modal" class="mc-report-modal" aria-labelledby="report-modal-title">
  <div class="mc-report-modal__content">
    <div class="mc-report-modal__header">
      <div class="mc-report-modal__title-wrap">
        <svg class="icon mc-icon-flag" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
          <line x1="4" y1="22" x2="4" y2="15"></line>
        </svg>
        <h2 id="report-modal-title" class="mc-report-modal__title">Report this item / Ba da rahoto</h2>
      </div>
      <button type="button" class="mc-modal-close-btn" id="close-report-modal" aria-label="Close report dialog">
        &times;
      </button>
    </div>

    <!-- MANDATORY EMERGENCY NOTICE (PRD Section 15.5 & Risk 1) -->
    <div class="mc-emergency-notice" role="alert">
      <svg class="icon mc-emergency-notice__icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <div class="mc-emergency-notice__body">
        <strong>Emergency Safety Notice:</strong>
        <p class="mc-emergency-notice__text">
          If a child is in immediate danger, contact local emergency services or the police now. Do not wait for us.
        </p>
      </div>
    </div>

    <form id="report-modal-form" class="mc-report-form">
      <input type="hidden" id="report-item-type" name="itemType" value="" />
      <input type="hidden" id="report-item-id" name="itemId" value="" />

      <div class="mc-report-item-preview" id="report-item-preview">
        <span class="mc-report-item-type-pill" id="report-item-type-pill">Item</span>
        <span class="mc-report-item-title-text" id="report-item-title-text">...</span>
      </div>

      <fieldset class="mc-form-group">
        <legend class="mc-label mc-label--required">Reason for report / Dalilin rahoto</legend>
        
        <div class="mc-radio-options">
          <label class="mc-radio-item">
            <input type="radio" name="reason" value="pupil_name_photo" required />
            <div class="mc-radio-content">
              <strong>Pupil name or photo / Sunan ko hoton ɗalibi</strong>
              <small>Names, pictures, or identifiable classroom details of children.</small>
            </div>
          </label>

          <label class="mc-radio-item">
            <input type="radio" name="reason" value="commercial_ad" />
            <div class="mc-radio-content">
              <strong>Commercial or advertisement / Talla ko kasuwanci</strong>
              <small>Promoting products, paid services, book sales, or spam.</small>
            </div>
          </label>

          <label class="mc-radio-item">
            <input type="radio" name="reason" value="religion_politics" />
            <div class="mc-radio-content">
              <strong>Religious or political debate / Muhawarar addini ko siyasa</strong>
              <small>Content straying into sectarian or political controversy.</small>
            </div>
          </label>

          <label class="mc-radio-item">
            <input type="radio" name="reason" value="copyright" />
            <div class="mc-radio-content">
              <strong>Copyright violation / Kwafin aikin wani ba izini</strong>
              <small>Scanned commercial textbooks or materials without permission.</small>
            </div>
          </label>

          <label class="mc-radio-item mc-radio-item--emergency">
            <input type="radio" name="reason" value="serious_safety" />
            <div class="mc-radio-content">
              <strong class="mc-emergency-highlight">Serious safety concern / Babbar matsalar tsaro</strong>
              <small>Child protection risk, violence, or dangerous classroom guidance (auto-hides immediately).</small>
            </div>
          </label>
        </div>
      </fieldset>

      <div class="mc-form-group">
        <label for="report-details" class="mc-label">Additional notes (optional) / Karin bayani</label>
        <textarea id="report-details" name="details" class="mc-textarea" rows="3" placeholder="Briefly describe the concern..."></textarea>
      </div>

      <div id="report-feedback" class="mc-feedback mc-feedback--info" style="display: none;" role="status">
        <div class="mc-feedback__body">
          <p class="mc-feedback__message" id="report-feedback-text"></p>
        </div>
      </div>

      <div class="mc-modal-actions">
        <button type="button" class="mc-btn mc-btn--secondary" id="cancel-report-modal">Cancel / Soke</button>
        <button type="submit" class="mc-btn mc-btn--danger" id="submit-report-btn">
          <span>Submit report / Aika rahoto</span>
        </button>
      </div>
    </form>
  </div>
</dialog>

<style>
  .mc-report-modal {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 0;
    max-width: 520px;
    width: 92%;
    box-shadow: var(--shadow-lg);
    background: var(--surface);
    color: var(--text-primary);
  }

  .mc-report-modal::backdrop {
    background: rgba(11, 25, 44, 0.65);
    backdrop-filter: blur(4px);
  }

  .mc-report-modal__content {
    display: flex;
    flex-direction: column;
  }

  .mc-report-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-bg);
  }

  .mc-report-modal__title-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mc-icon-flag {
    color: var(--danger);
  }

  .mc-report-modal__title {
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-bold);
    margin: 0;
    color: var(--text-primary);
  }

  .mc-modal-close-btn {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    min-width: 36px;
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .mc-modal-close-btn:hover {
    color: var(--text-primary);
    background: var(--border-subtle);
  }

  /* Fixed Emergency Notice (Section 15.5) */
  .mc-emergency-notice {
    background: var(--danger-subtle);
    border: 1px solid var(--danger-border);
    border-left: 4px solid var(--danger);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-4) var(--space-5) 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    border-radius: var(--radius-md);
  }

  .mc-emergency-notice__icon {
    color: var(--danger);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .mc-emergency-notice__body strong {
    color: var(--danger-text);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    display: block;
  }

  .mc-emergency-notice__text {
    margin: 2px 0 0;
    font-size: var(--fs-small);
    color: var(--danger-text);
    line-height: 1.35;
    font-weight: var(--fw-medium);
  }

  .mc-report-form {
    padding: var(--space-5);
  }

  .mc-report-item-preview {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--surface-bg);
    border: 1px solid var(--border);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    font-size: var(--fs-small);
  }

  .mc-report-item-type-pill {
    background: var(--brand-primary);
    color: var(--color-white);
    font-size: var(--fs-micro);
    font-weight: var(--fw-bold);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    text-transform: capitalize;
  }

  .mc-report-item-title-text {
    font-weight: var(--fw-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 320px;
    color: var(--text-primary);
  }

  .mc-radio-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .mc-radio-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    background: var(--surface);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .mc-radio-item:hover {
    background: var(--surface-bg);
    border-color: var(--border-focus);
  }

  .mc-radio-item input[type="radio"] {
    margin-top: 3px;
    accent-color: var(--brand-primary);
    width: 18px;
    height: 18px;
  }

  .mc-radio-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mc-radio-content strong {
    font-size: var(--fs-small);
    color: var(--text-primary);
  }

  .mc-radio-content small {
    font-size: var(--fs-micro);
    color: var(--text-muted);
  }

  .mc-radio-item--emergency {
    border-color: var(--danger-border);
    background: var(--danger-subtle);
  }

  .mc-emergency-highlight {
    color: var(--danger-text);
  }

  .mc-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .mc-btn--danger {
    background: var(--danger);
    color: var(--color-white);
    border: 1px solid var(--danger);
  }

  .mc-btn--danger:hover {
    background: var(--danger-hover, #991b1b);
  }
</style>

<script is:inline>
  (function initReportModal() {
    const dialog = document.getElementById('mc-report-modal');
    const closeBtn = document.getElementById('close-report-modal');
    const cancelBtn = document.getElementById('cancel-report-modal');
    const form = document.getElementById('report-modal-form');
    const itemTypeInput = document.getElementById('report-item-type');
    const itemIdInput = document.getElementById('report-item-id');
    const typePill = document.getElementById('report-item-type-pill');
    const titleText = document.getElementById('report-item-title-text');
    const feedbackBox = document.getElementById('report-feedback');
    const feedbackText = document.getElementById('report-feedback-text');
    const submitBtn = document.getElementById('submit-report-btn');

    function openModal(itemType, itemId, itemTitle) {
      if (!dialog) return;
      itemTypeInput.value = itemType || 'question';
      itemIdInput.value = itemId || '';
      if (typePill) typePill.textContent = itemType || 'Item';
      if (titleText) titleText.textContent = itemTitle || 'Item';
      form.reset();
      if (feedbackBox) feedbackBox.style.display = 'none';
      if (submitBtn) submitBtn.disabled = false;
      dialog.showModal();
    }

    function closeModal() {
      if (dialog && dialog.open) {
        dialog.close();
      }
    }

    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Global listener for elements with data-action="report"
    document.addEventListener('click', (e) => {
      const target = e.target.closest('[data-action="report"]');
      if (target) {
        e.preventDefault();
        const type = target.getAttribute('data-report-type') || 'question';
        const id = target.getAttribute('data-report-id') || '';
        const title = target.getAttribute('data-report-title') || 'Item';
        openModal(type, id, title);
      }
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const reason = formData.get('reason');
      const details = formData.get('details');
      const itemType = itemTypeInput.value;
      const itemId = itemIdInput.value;

      if (!reason) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';
      }

      // Check for serious safety
      const isSerious = reason === 'serious_safety';

      try {
        // Dynamic import to call submitReport in data seam
        const dataModule = await import('/src/lib/data.js');
        const res = await dataModule.submitReport({
          itemType,
          itemId,
          reason,
          details
        });

        if (feedbackBox && feedbackText) {
          feedbackBox.style.display = 'block';
          feedbackBox.className = isSerious ? 'mc-feedback mc-feedback--error' : 'mc-feedback mc-feedback--success';
          feedbackText.textContent = res.message || 'Report submitted successfully.';
        }

        // If auto-hidden, visually conceal the item in DOM
        if (res.autoHidden) {
          const domCard = document.getElementById(`${itemType}-${itemId}`) || 
                           document.getElementById(`reply-${itemId}`) || 
                           document.getElementById(`home-q-${itemId}`);
          if (domCard) {
            domCard.style.opacity = '0.4';
            domCard.style.filter = 'grayscale(1)';
            const hiddenNote = document.createElement('div');
            hiddenNote.style.padding = '8px';
            hiddenNote.style.background = '#fef2f2';
            hiddenNote.style.color = '#dc2626';
            hiddenNote.style.fontWeight = 'bold';
            hiddenNote.style.fontSize = '0.85rem';
            hiddenNote.style.marginTop = '6px';
            hiddenNote.textContent = 'Item hidden pending moderation review.';
            domCard.prepend(hiddenNote);
          }
        }

        setTimeout(() => {
          closeModal();
          if (submitBtn) {
            submitBtn.textContent = 'Submit report / Aika rahoto';
            submitBtn.disabled = false;
          }
        }, 1800);

      } catch (err) {
        if (feedbackBox && feedbackText) {
          feedbackBox.style.display = 'block';
          feedbackBox.className = 'mc-feedback mc-feedback--error';
          feedbackText.textContent = err.message || 'Unable to submit report.';
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit report / Aika rahoto';
        }
      }
    });
  })();
</script>
