---
interface Props {
  type?: "card" | "line" | "list";
  count?: number;
}

const { type = "card", count = 1 } = Astro.props;
const items = Array.from({ length: count });
---

<div class="mc-skeleton-container" aria-busy="true" aria-label="Loading content...">
  {items.map(() => (
    type === "card" ? (
      <div class="mc-skeleton-card">
        <div class="mc-skeleton-line" style="width: 40%; height: 14px; margin-bottom: 8px;"></div>
        <div class="mc-skeleton-line" style="width: 85%; height: 20px; margin-bottom: 12px;"></div>
        <div class="mc-skeleton-line" style="width: 100%; height: 14px; margin-bottom: 6px;"></div>
        <div class="mc-skeleton-line" style="width: 60%; height: 14px;"></div>
      </div>
    ) : type === "list" ? (
      <div class="mc-skeleton-list-item">
        <div class="mc-skeleton-circle"></div>
        <div style="flex: 1;">
          <div class="mc-skeleton-line" style="width: 70%; height: 16px; margin-bottom: 6px;"></div>
          <div class="mc-skeleton-line" style="width: 40%; height: 12px;"></div>
        </div>
      </div>
    ) : (
      <div class="mc-skeleton-line" style="width: 100%; height: 16px; margin-bottom: 8px;"></div>
    )
  ))}
</div>

<style>
  .mc-skeleton-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  .mc-skeleton-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .mc-skeleton-list-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--surface);
    border-bottom: 1px solid var(--border-subtle);
  }

  .mc-skeleton-circle {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--surface-bg);
    animation: mc-shimmer 1.5s infinite;
  }

  .mc-skeleton-line {
    background: var(--surface-bg);
    border-radius: var(--radius-sm);
    animation: mc-shimmer 1.5s infinite;
  }

  @keyframes mc-shimmer {
    0% { opacity: 0.6; }
    50% { opacity: 1; }
    100% { opacity: 0.6; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mc-skeleton-line,
    .mc-skeleton-circle {
      animation: none !important;
      opacity: 0.8 !important;
    }
  }
</style>
