---
// SignInModal.astro - Quick access Member Sign-In Modal
---

<dialog id="signin-modal" class="mc-signin-modal" aria-labelledby="signin-modal-title">
  <div class="mc-signin-modal__content">
    <div class="mc-signin-modal__header">
      <h2 id="signin-modal-title" style="font-size: var(--fs-h3); margin: 0; color: var(--text-primary);">
        Sign In / Shiga
      </h2>
      <button type="button" class="mc-btn mc-btn--secondary" id="btn-close-signin-modal" aria-label="Close sign in dialog" style="min-height: 36px; padding: 4px 10px;">
        ✕
      </button>
    </div>

    <form id="signin-modal-form" class="mc-signin-modal__body">
      <!-- Error Alert -->
      <div id="signin-error-alert" class="mc-feedback mc-feedback--error" style="display: none; margin-bottom: var(--space-3);" role="alert">
        <svg class="icon mc-feedback__icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <div class="mc-feedback__body">
          <p class="mc-feedback__message" id="signin-error-text">Wrong PIN. Please check and retry.</p>
        </div>
      </div>

      <!-- Lockout Notice (PRD Rule F4-09) -->
      <div id="signin-lock-alert" class="mc-feedback mc-feedback--warning" style="display: none; margin-bottom: var(--space-3);" role="alert">
        <svg class="icon mc-feedback__icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <div class="mc-feedback__body">
          <strong class="mc-feedback__title">Account Locked</strong>
          <p class="mc-feedback__message" id="signin-lock-text">Account locked for 15 minutes after 5 failed tries.</p>
        </div>
      </div>

      <!-- Username -->
      <div class="mc-form-group">
        <label for="signin-username" class="mc-label">Username</label>
        <input 
          type="text" 
          id="signin-username" 
          name="username" 
          class="mc-input" 
          placeholder="e.g. musa_science" 
          required 
          autocomplete="username"
        />
      </div>

      <!-- 6-Digit PIN (Masked, No browser autocomplete) -->
      <div class="mc-form-group">
        <label for="signin-pin" class="mc-label">6-Digit PIN</label>
        <input 
          type="password" 
          id="signin-pin" 
          name="pin" 
          class="mc-input" 
          placeholder="••••••" 
          required 
          inputmode="numeric" 
          pattern="[0-9]{6}" 
          maxlength="6" 
          autocomplete="off" 
          style="letter-spacing: 4px; font-size: 18px;"
        />
        <span class="mc-helper-text">Enter your 6-digit number code.</span>
      </div>

      <!-- Shared Phone Checkbox (PRD Section 2.5) -->
      <div class="mc-form-group">
        <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--fs-small); cursor: pointer;">
          <input type="checkbox" id="signin-shared-phone" name="isSharedPhone" style="accent-color: var(--brand-primary);" />
          <span>This is a shared phone (Signs out and clears saved items on idle)</span>
        </label>
      </div>

      <button type="submit" class="mc-btn mc-btn--primary" id="btn-signin-submit" style="width: 100%; margin-top: var(--space-3);">
        <span>Sign In / Shiga</span>
      </button>

      <div style="margin-top: var(--space-4); text-align: center; font-size: var(--fs-small);">
        <span style="color: var(--text-muted);">New teacher?</span>
        <a href="/join" style="color: var(--brand-primary); font-weight: var(--fw-semibold); text-decoration: none; margin-left: 4px;">
          Create account
        </a>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { signIn, getLoginAttemptsStatus } from "../lib/data.js";
  import { initIdleWatcher } from "../lib/idleWatcher.js";

  const modal = document.getElementById('signin-modal') as HTMLDialogElement | null;
  const form = document.getElementById('signin-modal-form');
  const btnClose = document.getElementById('btn-close-signin-modal');
  const errorAlert = document.getElementById('signin-error-alert');
  const errorText = document.getElementById('signin-error-text');
  const lockAlert = document.getElementById('signin-lock-alert');
  const lockText = document.getElementById('signin-lock-text');
  const submitBtn = document.getElementById('btn-signin-submit') as HTMLButtonElement | null;

  // Global opener listener
  window.addEventListener('open-signin-modal', () => {
    checkLockStatus();
    modal?.showModal();
  });

  document.querySelectorAll('[data-action="open-signin"]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      checkLockStatus();
      modal?.showModal();
    });
  });

  btnClose?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  function checkLockStatus() {
    const status = getLoginAttemptsStatus();
    if (status.isLocked) {
      if (lockAlert && lockText) {
        lockText.textContent = `Account locked for ${status.remainingMinutes} more minutes after 5 failed tries.`;
        lockAlert.style.display = 'flex';
      }
      if (submitBtn) submitBtn.disabled = true;
    } else {
      if (lockAlert) lockAlert.style.display = 'none';
      if (submitBtn) submitBtn.disabled = false;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorAlert) errorAlert.style.display = 'none';

    const usernameInput = (document.getElementById('signin-username') as HTMLInputElement)?.value;
    const pinInput = (document.getElementById('signin-pin') as HTMLInputElement)?.value;
    const isShared = (document.getElementById('signin-shared-phone') as HTMLInputElement)?.checked;

    try {
      if (submitBtn) submitBtn.disabled = true;
      await signIn({
        username: usernameInput,
        pin: pinInput,
        isSharedPhone: isShared
      });

      localStorage.setItem('mc_is_shared_phone', isShared ? 'true' : 'false');
      if (isShared) {
        initIdleWatcher({ isSharedPhone: true });
      }

      modal?.close();
      window.location.href = '/profile';
    } catch (err: any) {
      if (submitBtn) submitBtn.disabled = false;
      checkLockStatus();
      if (errorAlert && errorText) {
        errorText.textContent = err.message || "Could not sign in. Check your username and PIN.";
        errorAlert.style.display = 'flex';
      }
    }
  });
</script>

<style>
  .mc-signin-modal {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 0;
    max-width: 440px;
    width: 92%;
    box-shadow: var(--shadow-lg);
    background: var(--surface);
    color: var(--text-primary);
  }

  .mc-signin-modal::backdrop {
    background: rgba(11, 25, 44, 0.65);
    backdrop-filter: blur(4px);
  }

  .mc-signin-modal__content {
    display: flex;
    flex-direction: column;
  }

  .mc-signin-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-bg);
  }

  .mc-signin-modal__body {
    padding: var(--space-5);
  }
</style>
