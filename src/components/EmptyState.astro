---
interface Props {
  title?: string;
  message: string;
  actionText?: string;
  actionHref?: string;
  icon?: string;
}

const { 
  title, 
  message, 
  actionText, 
  actionHref,
  icon = "info-circle" 
} = Astro.props;
---

<div class="mc-empty-state" role="region" aria-label="Empty content area">
  <div class="mc-empty-state__icon-box">
    {icon === "info-circle" && (
      <svg class="icon" viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    )}
    {icon === "search" && (
      <svg class="icon" viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    )}
    {icon === "clock" && (
      <svg class="icon" viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    )}
    {icon === "bookmark" && (
      <svg class="icon" viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
    )}
    {icon === "check-circle" && (
      <svg class="icon" viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    )}
  </div>

  {title && <h3 class="mc-empty-state__title">{title}</h3>}
  <p class="mc-empty-state__message">{message}</p>

  {actionText && actionHref && (
    <a href={actionHref} class="mc-btn mc-btn--secondary mc-empty-state__btn">
      <span>{actionText}</span>
    </a>
  )}
</div>

<style>
  .mc-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8) var(--space-4);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    width: 100%;
    margin: var(--space-4) 0;
    box-shadow: var(--shadow-subtle);
  }

  .mc-empty-state__icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
    color: var(--brand-primary);
    border: 1px solid var(--border-subtle);
    margin-bottom: var(--space-3);
  }

  .mc-empty-state__title {
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-bold);
    color: var(--brand-navy, var(--text-primary));
    margin: 0 0 var(--space-1) 0;
  }

  .mc-empty-state__message {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
    max-width: var(--prose-max);
    margin: 0;
  }

  .mc-empty-state__btn {
    margin-top: var(--space-4);
  }
</style>
