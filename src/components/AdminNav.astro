---
// Admin & Moderation Sub-Navigation (PRD Section 7)
interface Props {
  activeTab: "reports" | "approvals" | "members" | "numbers" | "settings";
  viewerRole?: string;
}

const { activeTab, viewerRole = "Admin" } = Astro.props;
---

<div class="mc-admin-nav-container">
  <div class="mc-admin-topbar">
    <div class="mc-admin-breadcrumbs">
      <a href="/home" class="mc-admin-back-link">
        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Malamai Circle</span>
      </a>
      <span class="mc-admin-badge mc-admin-badge--role">Role: {viewerRole}</span>
    </div>

    <div class="mc-admin-notice-pill">
      <span>Work hours moderation only (Section 7)</span>
    </div>
  </div>

  <nav class="mc-admin-tabs" aria-label="Admin Navigation Tabs">
    <a 
      href="/admin/reports" 
      class:list={["mc-admin-tab", { "is-active": activeTab === "reports" }]}
      aria-current={activeTab === "reports" ? "page" : undefined}
    >
      <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
        <line x1="4" y1="22" x2="4" y2="15"></line>
      </svg>
      <span>Report Queue</span>
    </a>

    <a 
      href="/admin/approvals" 
      class:list={["mc-admin-tab", { "is-active": activeTab === "approvals" }]}
      aria-current={activeTab === "approvals" ? "page" : undefined}
    >
      <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 11 12 14 22 4"></polyline>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
      </svg>
      <span>Upload Approvals</span>
    </a>

    <a 
      href="/admin/members" 
      class:list={["mc-admin-tab", { "is-active": activeTab === "members" }]}
      aria-current={activeTab === "members" ? "page" : undefined}
    >
      <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <span>Members</span>
    </a>

    <a 
      href="/admin/numbers" 
      class:list={["mc-admin-tab", { "is-active": activeTab === "numbers" }]}
      aria-current={activeTab === "numbers" ? "page" : undefined}
    >
      <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
      <span>Numbers &amp; Egress</span>
    </a>

    <a 
      href="/admin/settings" 
      class:list={["mc-admin-tab", { "is-active": activeTab === "settings" }]}
      aria-current={activeTab === "settings" ? "page" : undefined}
    >
      <svg class="icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      <span>Export &amp; Read-Only</span>
    </a>
  </nav>
</div>

<style>
  .mc-admin-nav-container {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-card);
  }

  .mc-admin-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .mc-admin-breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mc-admin-back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--brand-primary);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    transition: color 0.15s ease;
  }

  .mc-admin-back-link:hover {
    color: var(--brand-primary-hover);
    text-decoration: underline;
  }

  .mc-admin-badge--role {
    font-size: var(--fs-micro);
    background: var(--brand-primary-tint, #F0FDFA);
    color: var(--brand-primary, #0D9488);
    border: 1px solid var(--border-subtle);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-weight: var(--fw-bold);
  }

  .mc-admin-notice-pill {
    font-size: var(--fs-micro);
    color: var(--text-muted);
  }

  .mc-admin-tabs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .mc-admin-tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 14px;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
    min-height: 40px;
    transition: all 0.15s ease;
  }

  .mc-admin-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .mc-admin-tab.is-active {
    background: var(--brand-primary);
    color: #FFFFFF;
    border-color: var(--brand-primary);
    font-weight: var(--fw-bold);
    box-shadow: var(--shadow-subtle);
  }

  .mc-admin-tab.is-active svg {
    stroke: #FFFFFF;
  }
</style>
