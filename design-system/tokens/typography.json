{
  "fontFamilies": {
    "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, \"Roboto Mono\", Menlo, Consolas, monospace"
  },
  "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "scale": {
    "micro":   { "size": "12px", "lineHeight": "1.4",  "weight": 500, "tracking": "0.02em",  "use": "meta labels only, sparingly" },
    "small":   { "size": "14px", "lineHeight": "1.45", "weight": 400, "tracking": "0",        "use": "captions, helper text" },
    "body":    { "size": "16px", "lineHeight": "1.6",  "weight": 400, "tracking": "0",        "use": "default text" },
    "bodyLg":  { "size": "18px", "lineHeight": "1.6",  "weight": 400, "tracking": "0",        "use": "lead paragraphs" },
    "titleSm": { "size": "20px", "lineHeight": "1.4",  "weight": 600, "tracking": "0",        "use": "card titles" },
    "h3":      { "size": "24px", "lineHeight": "1.35", "weight": 600, "tracking": "0",        "use": "section headings" },
    "h2":      { "size": "30px", "lineHeight": "1.3",  "weight": 700, "tracking": "-0.005em", "use": "page sections" },
    "h1":      { "size": "36px", "lineHeight": "1.2",  "weight": 700, "tracking": "-0.01em",  "use": "page title" }
  }
}
